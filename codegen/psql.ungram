// Psql Un-Grammar.
//
// This grammar specifies the structure of Rust's concrete syntax tree.
// It does not specify parsing rules (ambiguities, precedence, etc are out of scope).
// Tokens are processed -- contextual keywords are recognised, compound operators glued.
//
// Legend:
//
//   //          				-- comment
//   Name =      				-- non-terminal definition
//   'ident'     				-- token (terminal)
//   A B         				-- sequence
//   A | B       				-- alternation
//   A*          				-- zero or Psqlore repetition
//   (A (',' A)* ','?)	        -- repetition of node A separated by ',' and allowing a trailing comma
//   (A (',' A)*)	            -- repetition of node A separated by ',' without a trailing comma
//   A?          				-- zero or one repetition
//   (A)         				-- same as A
//   label:A     				-- suggested name for field of AST node

// NOTES
//
// - SyntaxNode, SyntaxToken and SyntaxElement will be stripped from the codegen
// - Bogus nodes are special nodes used to keep track of broken code; they are
//   not part of the grammar but they will appear inside the green tree
//


///////////////
// Bogus NODES
///////////////
// SyntaxElement is a generic data structure that is Psqleant to track nodes and tokens
// in cases where we care about both types
//
// As Bogus* node will need to yield both tokens and nodes without discrimination,
// and their children will need to yield nodes and tokens as well.
// For this reason, SyntaxElement = SyntaxElement
SyntaxElement = SyntaxElement

PsqlBogus = SyntaxElement*
PsqlBogusStatement = SyntaxElement*
PsqlBogusExpression = SyntaxElement*
PsqlBogusMember = SyntaxElement*
PsqlBogusBinding = SyntaxElement*
PsqlBogusAssignment = SyntaxElement*
PsqlBogusParameter = SyntaxElement*

///////////////
// Literals
///////////////
AnyPsqlLiteralExpression =
	PsqlStringLiteralExpression
	| PsqlNumberLiteralExpression
	| PsqlBooleanLiteralExpression
	| PsqlNullLiteralExpression

PsqlStringLiteralExpression = value: 'Psql_string_literal'
PsqlNumberLiteralExpression = value: 'Psql_number_literal'
PsqlBooleanLiteralExpression = value: ( 'true' | 'false' )
PsqlNullLiteralExpression = value: 'null'

///////////////
PsqlName = value: 'ident'
PsqlStar = value: '*'

// `:name`/`:N`, a colon-prefixed bind parameter -- a widely-used SQL
// client/tooling convention (DBeaver, JDBC named parameters, SQLAlchemy,
// etc.), not real Postgres wire-protocol syntax (that's `$1`, not
// implemented here) and not mlang-specific, so this is available in both
// dialects. `:` is otherwise unused in this grammar (only `::` cast is),
// so no lexer disambiguation is needed, unlike `~name~`.
PsqlParameterExpression = ':' name: ( 'ident' | 'Psql_number_literal' )

// A `LIMIT`/`OFFSET` value: a bare number literal, or a bind parameter
// (`LIMIT :n`) -- real Postgres itself accepts any expression here, but
// this grammar deliberately narrows it to just these two, the only forms
// that occur in practice.
AnyPsqlLimitValue =
   PsqlNumberLiteralExpression
   | PsqlParameterExpression

// `~name~`/`~$name~`, a table or function name written in the mlang
// dialect's own convention rather than plain Postgres syntax -- not part of
// real Postgres, presumably expanded by mlang's runtime before the query
// reaches an actual database. Distinct from `PsqlName` since it's only
// valid in table/function-name position, never for columns/aliases/CTEs.
PsqlTildeName = value: 'Psql_tilde_name_literal'

AnyPsqlName =
   PsqlName
   | PsqlTildeName

PsqlRoot = 
   stmt: PsqlStatementList
   eof: 'EOF'

PsqlStatementList = AnyPsqlStatement*

AnyPsqlStatement =
   PsqlSelectStatement
   | PsqlInsertStatement
   | PsqlDeleteStatement
   | PsqlUpdateStatement
   | PsqlEmptyStatement
   | PsqlDropFunctionStatement
   | PsqlDropTableStatement
   | PsqlCreateTableStatement
   | PsqlCreateFunctionStatement
   | PsqlCreateViewStatement
   | PsqlDropViewStatement
   | PsqlCreatePolicyStatement
   | PsqlDropPolicyStatement
   | PsqlCreateTriggerStatement
   | PsqlDropTriggerStatement
   | PsqlBogusStatement

///////////////
// Statements
///////////////

// A stray `;` with nothing before it, e.g. the second `;` in `select 1;;`.
// Harmless -- most SQL implementations treat it as a no-op, not an error.
PsqlEmptyStatement =
   ';'

PsqlWithClause =
   'with'
   'recursive'?
   ctes: PsqlCteDefinitionList

PsqlCteDefinitionList = (PsqlCteDefinition (',' PsqlCteDefinition)* )

PsqlCteDefinition =
   name: PsqlName
   columns: PsqlColumnList?
   'as'
   '('
   query: AnyPsqlStatement
   ')'

PsqlSelectStatement =
   with_clause: PsqlWithClause?
   select_clause: PsqlSelectClause
   from_clause: PsqlFromClause?
   where_clause: PsqlWhereClause?
   group_by_clause: PsqlGroupByClause?
   having_clause: PsqlHavingClause?
   set_operations: PsqlSetOperationList
   order_by_clause: PsqlOrderByClause?
   limit_clause: PsqlLimitClause?
   offset_clause: PsqlOffsetClause?
   ';'?

PsqlSetOperationList = PsqlSetOperation*

PsqlSetOperation =
   operator_token: ('union' | 'intersect' | 'except')
   quantifier: ('all' | 'distinct')?
   select_clause: PsqlSelectClause
   from_clause: PsqlFromClause?
   where_clause: PsqlWhereClause?
   group_by_clause: PsqlGroupByClause?
   having_clause: PsqlHavingClause?

PsqlSelectClause =
   'select'
   list: PsqlSelectItemList

PsqlSelectItemList = (AnyPsqlSelectItem (',' AnyPsqlSelectItem)* ','?)

AnyPsqlSelectItem =
   PsqlStar
   | PsqlSelectExpression

PsqlSelectExpression =
   expr: AnyPsqlExpression
   alias: PsqlAlias?

PsqlFromClause =
   'from'
   items: PsqlFromItemList

PsqlFromItemList = (PsqlFromItem (',' PsqlFromItem)* )

PsqlFromItem =
   source: AnyPsqlFromExpression
   joins: PsqlJoinClauseList

PsqlJoinClauseList = PsqlJoinClause*

PsqlJoinClause =
   join_type: ('inner' | 'left' | 'right' | 'full' | 'cross')?
   'outer'?
   'join'
   source: AnyPsqlFromExpression
   ('on' condition: AnyPsqlExpression)?

AnyPsqlFromExpression =
   PsqlTableBinding
   | PsqlFunctionBinding
   | PsqlSubqueryBinding

PsqlSubqueryBinding =
   '('
   query: PsqlSelectStatement
   ')'
   alias: PsqlAlias?

PsqlWhereClause =
   'where'
   condition: AnyPsqlExpression

PsqlGroupByClause = 
   'group_by' 
   items: PsqlGroupByItemList

PsqlGroupByItemList = (AnyPsqlExpression (',' AnyPsqlExpression)* ','?)

PsqlHavingClause =
   'having'
   condition: AnyPsqlExpression

PsqlLimitClause =
   'limit'
   limit_count: AnyPsqlLimitValue

PsqlOrderByClause =
   'order_by'
   items: PsqlOrderByExpressionList

PsqlOrderByExpressionList = (PsqlOrderByExpression (',' PsqlOrderByExpression)*)

PsqlOrderByExpression = 
   item: AnyPsqlExpression
   order: ('asc' | 'desc')?

PsqlOffsetClause =
   'offset'
   start: AnyPsqlLimitValue

PsqlInsertStatement =
   with_clause: PsqlWithClause?
   'insert'
   'into'
   table: PsqlTableBinding
   columns: PsqlColumnList?
   source: AnyPsqlInsertSource
   on_conflict_clause: PsqlOnConflictClause?
   returning_clause: PsqlReturningClause?
   ';'?

PsqlReturningClause =
   'returning'
   items: PsqlSelectItemList

PsqlColumnList =
   '('
   items: PsqlColumnNameList
   ')'

PsqlColumnNameList = (PsqlName (',' PsqlName)*)

AnyPsqlInsertSource =
   PsqlInsertValues 
   | PsqlSelectStatement

PsqlInsertValues =
   'values'
   '('
   items: PsqlExpressionList
   ')'

PsqlOnConflictClause =
   'on'
   'conflict'
   target: AnyPsqlConflictTarget?
   action: AnyPsqlConflictAction

AnyPsqlConflictTarget =
   PsqlColumnList
   | PsqlOnConstraintClause

PsqlOnConstraintClause =
   'on'
   'constraint'
   name: PsqlName

AnyPsqlConflictAction =
   PsqlDoNothingClause
   | PsqlDoUpdateClause

PsqlDoNothingClause =
   'do'
   'nothing'

PsqlDoUpdateClause =
   'do'
   'update'
   set_clause: PsqlSetClause
   where_clause: PsqlWhereClause?

PsqlDeleteStatement =
   with_clause: PsqlWithClause?
   'delete'
   'from'
   table: PsqlTableBinding
   using: PsqlDeleteUsingClause?
   where_clause: PsqlWhereClause?
   returning_clause: PsqlReturningClause?
   ';'?

PsqlDeleteUsingClause =
   'using'
   items: PsqlFromItemList

PsqlUpdateStatement =
   with_clause: PsqlWithClause?
   'update'
   table: PsqlTableBinding
   set_clause: PsqlSetClause
   where_clause: PsqlWhereClause?
   returning_clause: PsqlReturningClause?
   ';'?

PsqlSetClause = 
   'set'
   items: PsqlSetItemList

PsqlSetItemList = (PsqlSetItem (',' PsqlSetItem)*)

PsqlSetItem = 
   column: PsqlName
   '='
   expr: AnyPsqlExpression

///////////////
// DDL
///////////////

// `DROP FUNCTION|PROCEDURE [IF EXISTS] name [(type, ...)] [CASCADE|RESTRICT] [;]`
// -- Postgres DDL for removing a stored function/procedure. `GO` (a T-SQL
// batch separator some client scripts still carry over from MSSQL) is
// deliberately not part of this grammar; it already recovers fine as
// ordinary bogus-statement content between two real statements.
PsqlDropFunctionStatement =
   'drop'
   kind: ('function' | 'procedure')
   ('if' 'exists')?
   name: AnyPsqlName
   parameters: PsqlDropFunctionParameters?
   drop_behavior: ('cascade' | 'restrict')?
   ';'?

PsqlDropFunctionParameters =
   '('
   items: PsqlTypeNameList
   ')'

PsqlTypeNameList = (PsqlTypeName (',' PsqlTypeName)*)

// `DROP TABLE [IF EXISTS] name (',' name)* [CASCADE|RESTRICT] [;]`
PsqlDropTableStatement =
   'drop'
   'table'
   ('if' 'exists')?
   tables: PsqlTableNameList
   drop_behavior: ('cascade' | 'restrict')?
   ';'?

PsqlTableNameList = (PsqlTableName (',' PsqlTableName)*)

// `CREATE TABLE [IF NOT EXISTS] name (col type, col type, ...) [;]` --
// column list only for now, no column-level (NOT NULL/DEFAULT/PRIMARY KEY/
// ...) or table-level (CONSTRAINT/FOREIGN KEY/...) constraints yet. No real
// example in the client corpus this grammar is otherwise grounded in, so
// this deliberately starts minimal rather than guessing at the full
// standard-Postgres constraint grammar up front.
PsqlCreateTableStatement =
   'create'
   'table'
   ('if' 'not' 'exists')?
   name: PsqlTableName
   '('
   columns: PsqlColumnDefinitionList
   ')'
   ';'?

PsqlColumnDefinitionList = (PsqlColumnDefinition (',' PsqlColumnDefinition)*)

PsqlColumnDefinition =
   name: PsqlName
   type: PsqlTypeName

// `CREATE [OR REPLACE] FUNCTION|PROCEDURE name(param type, ...) [RETURNS
// type] <options>* AS body <options>* [;]` -- real scripts scatter options
// (`LANGUAGE`, volatility, `SECURITY DEFINER`/`INVOKER`, `STRICT`) both
// before and after `AS`, in any order, so both are the same repeatable
// `PsqlFunctionOptionList`, not a fixed sequence.
// `body` is a plain string-literal expression (covers both `'...'` and the
// dollar-quoted `$$...$$`/`$tag$...$tag$` spelling) and is printed verbatim
// by the formatter -- PL/pgSQL body contents are never reparsed or
// reformatted.
PsqlCreateFunctionStatement =
   'create'
   ('or' 'replace')?
   kind: ('function' | 'procedure')
   name: AnyPsqlName
   '('
   parameters: PsqlFunctionParameterList
   ')'
   returns_clause: PsqlReturnsClause?
   leading_options: PsqlFunctionOptionList
   'as'
   body: PsqlStringLiteralExpression
   trailing_options: PsqlFunctionOptionList
   ';'?

PsqlFunctionOptionList = AnyPsqlFunctionOption*

AnyPsqlFunctionOption =
   PsqlLanguageOption
   | PsqlVolatilityOption
   | PsqlSecurityOption
   | PsqlStrictOption
   | PsqlReturnsNullOption

// `RETURNS NULL ON NULL INPUT` -- a synonym for `STRICT`. The two `'null'`s
// need distinct labels -- otherwise codegen gives both the same accessor
// name and the generated struct doesn't compile (duplicate field), the
// same issue `PsqlTildeArraySuffix`'s two `~`s already ran into.
PsqlReturnsNullOption =
   'returns'
   first_null: 'null'
   'on'
   second_null: 'null'
   'input'

PsqlVolatilityOption =
   value: ('immutable' | 'stable' | 'volatile')

PsqlSecurityOption =
   'security'
   value: ('definer' | 'invoker')

PsqlStrictOption =
   'strict'

PsqlFunctionParameterList = (PsqlFunctionParameter (',' PsqlFunctionParameter)*)

PsqlFunctionParameter =
   mode: ('in' | 'out' | 'inout')?
   name: PsqlName
   type: PsqlTypeName
   default: PsqlParameterDefault?

// Postgres allows either spelling for a parameter default -- `DEFAULT expr`
// or the shorthand `= expr` -- both seen in real scripts.
PsqlParameterDefault =
   marker: ('default' | '=')
   value: AnyPsqlExpression

PsqlReturnsClause =
   'returns'
   type: AnyPsqlReturnsType

AnyPsqlReturnsType =
   PsqlTypeName
   | PsqlReturnsTableClause
   | PsqlReturnsTriggerClause
   | PsqlReturnsSetofClause

// `RETURNS SETOF type` -- a set-returning function's row type, given as a
// single (usually scalar) type rather than an inline column list.
PsqlReturnsSetofClause =
   'setof'
   type: PsqlTypeName

// `RETURNS TABLE(col type, col type, ...)` -- a set-returning function's
// result-row shape.
PsqlReturnsTableClause =
   'table'
   '('
   columns: PsqlReturnsTableColumnList
   ')'

// `RETURNS TRIGGER` -- the pseudo-type convention marking a function as a
// trigger function, callable only via `CREATE TRIGGER ... EXECUTE FUNCTION`.
PsqlReturnsTriggerClause =
   'trigger'

PsqlReturnsTableColumnList = (PsqlReturnsTableColumn (',' PsqlReturnsTableColumn)*)

PsqlReturnsTableColumn =
   name: PsqlName
   type: PsqlTypeName

// `CREATE [OR REPLACE] VIEW name [WITH (opt=val, ...)] AS <select>` -- the
// view body is an ordinary `SELECT` statement, already fully supported;
// only the thin wrapper is new here.
PsqlCreateViewStatement =
   'create'
   ('or' 'replace')?
   'view'
   name: PsqlTableName
   options: PsqlViewOptions?
   'as'
   query: PsqlSelectStatement
   ';'?

PsqlViewOptions =
   'with'
   '('
   items: PsqlViewOptionList
   ')'

PsqlViewOptionList = (PsqlViewOption (',' PsqlViewOption)*)

PsqlViewOption =
   name: PsqlName
   '='
   value: AnyPsqlExpression

// `DROP VIEW [IF EXISTS] name (',' name)* [CASCADE|RESTRICT] [;]`
PsqlDropViewStatement =
   'drop'
   'view'
   ('if' 'exists')?
   views: PsqlTableNameList
   drop_behavior: ('cascade' | 'restrict')?
   ';'?

// `CREATE POLICY name ON table [FOR ALL|SELECT|INSERT|UPDATE|DELETE]
// [USING (condition)] [;]` -- the `USING` condition is an ordinary boolean
// expression, already fully supported (including subqueries/function
// calls); only the thin wrapper is new here.
PsqlCreatePolicyStatement =
   'create'
   'policy'
   name: PsqlName
   'on'
   table: PsqlTableName
   for_clause: PsqlPolicyForClause?
   using_clause: PsqlPolicyUsingClause?
   ';'?

PsqlPolicyForClause =
   'for'
   command: ('all' | 'select' | 'insert' | 'update' | 'delete')

PsqlPolicyUsingClause =
   'using'
   '('
   condition: AnyPsqlExpression
   ')'

// `DROP POLICY [IF EXISTS] name ON table [;]`
PsqlDropPolicyStatement =
   'drop'
   'policy'
   ('if' 'exists')?
   name: PsqlName
   'on'
   table: PsqlTableName
   ';'?

// `CREATE TRIGGER name {BEFORE|AFTER} event [OR event]* ON table
// [REFERENCING ...] [FOR EACH ROW|STATEMENT] EXECUTE FUNCTION|PROCEDURE
// name(args) [;]` -- the trigger *function* itself is a separate
// `CREATE FUNCTION ... RETURNS TRIGGER`; this is just the attachment.
PsqlCreateTriggerStatement =
   'create'
   'trigger'
   name: AnyPsqlName
   timing: ('before' | 'after')
   events: PsqlTriggerEventList
   'on'
   table: PsqlTableName
   referencing_clause: PsqlTriggerReferencingClause?
   for_each_clause: PsqlTriggerForEachClause?
   when_clause: PsqlTriggerWhenClause?
   'execute'
   function_kind: ('function' | 'procedure')
   function: PsqlCallExpression
   ';'?

// `WHEN (condition)` -- restricts a row-level trigger to fire only when
// `condition` holds (referencing `OLD`/`NEW` like the trigger body does).
PsqlTriggerWhenClause =
   'when'
   '('
   condition: AnyPsqlExpression
   ')'

PsqlTriggerEventList = PsqlTriggerEvent*

// The leading `'or'?` is only present on every event after the first (the
// same "each element owns its own separator" shape as `PsqlSetOperation`).
PsqlTriggerEvent =
   'or'?
   kind: ('insert' | 'update' | 'delete')
   of_clause: PsqlTriggerUpdateOfClause?

// `UPDATE OF col, col, ...` -- narrows an `UPDATE` event to specific
// columns; only ever follows an `update` event kind.
PsqlTriggerUpdateOfClause =
   'of'
   columns: PsqlColumnNameList

// `REFERENCING OLD TABLE AS old_name NEW TABLE AS new_name` (either or both,
// in either order) -- names the transition tables for statement-level
// triggers.
PsqlTriggerReferencingClause =
   'referencing'
   items: PsqlTriggerReferencingItemList

PsqlTriggerReferencingItemList = PsqlTriggerReferencingItem*

// `which` holds the literal text `old`/`new` (checked at parse time, case
// insensitively) rather than being a keyword-token alternation: unlike
// `~name~`, real Postgres never reserves `OLD`/`NEW` as keywords at all --
// they must still parse as ordinary identifiers everywhere outside a
// `REFERENCING` item (e.g. `old.some_column` in a trigger's `WHEN (...)`
// condition or body).
PsqlTriggerReferencingItem =
   which: 'ident'
   'table'
   'as'
   name: PsqlName

PsqlTriggerForEachClause =
   'for'
   'each'
   granularity: ('row' | 'statement')

// `DROP TRIGGER [IF EXISTS] name ON table [CASCADE|RESTRICT] [;]`
PsqlDropTriggerStatement =
   'drop'
   'trigger'
   ('if' 'exists')?
   name: AnyPsqlName
   'on'
   table: PsqlTableName
   drop_behavior: ('cascade' | 'restrict')?
   ';'?

PsqlLanguageOption =
   'language'
   name: PsqlName

///////////////////////
// Parts of expressions
///////////////////////

PsqlTableColReference =
   table: PsqlTableName
   '.'
   name: PsqlName

PsqlColReference =
   name: PsqlName

PsqlAlias = 
   'as'?
   value: PsqlName

PsqlDataBaseName =
   name: PsqlName
   '.'

PsqlShemaName =
   base: PsqlDataBaseName?
   name: PsqlName
   '.'

PsqlTableName =
   schema: PsqlShemaName?
   name: AnyPsqlName

PsqlTableBinding = 
   table: PsqlTableName
   alias: PsqlAlias?

PsqlFunctionBinding =
   schema: PsqlShemaName?
   name: PsqlName
   '('
   arguments: PsqlExpressionList
   ')'
   alias: PsqlAlias?

PsqlExpressionList = (AnyPsqlExpression (',' AnyPsqlExpression)* )

AnyPsqlExpression =
   PsqlName
   | PsqlStar
   | PsqlParameterExpression
   | PsqlTableColReference
   | PsqlColReference
   | PsqlBinaryExpression
   | PsqlLogicalExpression
   | PsqlUnaryExpression
   | PsqlIsNullExpression
   | PsqlBetweenExpression
   | PsqlInExpression
   | PsqlLikeExpression
   | PsqlCaseExpression
   | PsqlParenthesizedExpression
   | PsqlSubqueryExpression
   | PsqlCallExpression
   | PsqlWindowFunctionExpression
   | PsqlArrayExpression
   | PsqlArraySubscriptExpression
   | PsqlCastExpression
   | PsqlCastFunctionExpression
   | PsqlAnyAllExpression
   | AnyPsqlLiteralExpression

// `ANY (subquery|expr)` / `ALL (subquery|expr)` / `SOME (subquery|expr)` --
// a quantified comparison, e.g. `x = ANY (select id from t)` or
// `x <> ALL (array[1, 2])`. Reuses the existing parenthesized-subquery and
// parenthesized-expression nodes as-is (both already own their parens),
// the same way `AnyPsqlInSource` reuses them for `IN (...)`.
PsqlAnyAllExpression =
   quantifier: ('any' | 'all' | 'some')
   source: AnyPsqlAnyAllSource

AnyPsqlAnyAllSource =
   PsqlSubqueryExpression
   | PsqlParenthesizedExpression

PsqlArrayExpression =
   'array'
   '['
   items: PsqlExpressionList
   ']'

PsqlArraySubscriptExpression =
   expression: AnyPsqlExpression
   '['
   index: AnyPsqlExpression
   ']'

PsqlCastExpression =
   expression: AnyPsqlExpression
   '::'
   type: PsqlTypeName

PsqlCastFunctionExpression =
   'cast'
   '('
   expression: AnyPsqlExpression
   'as'
   type: PsqlTypeName
   ')'

PsqlTypeName =
   name: ('ident' | 'integer' | 'bigint' | 'varchar' | 'char' | 'text' | 'boolean' | 'date' | 'time' | 'timestamp' | 'interval' | 'numeric' | 'decimal' | 'double' | 'real' | 'json' | 'jsonb' | 'uuid' | 'array' | 'bytea' | 'bit')
   args: PsqlTypeArguments?
   modifier: AnyPsqlTypeModifier?
   array_suffix: AnyPsqlTypeArraySuffix?

// The handful of multi-word SQL-standard type spellings real scripts use:
// `character varying`, `bit varying`, `double precision`, `time[/stamp]
// [(p)] [ WITH | WITHOUT ] TIME ZONE`.
AnyPsqlTypeModifier =
   PsqlVaryingModifier
   | PsqlPrecisionModifier
   | PsqlTimeZoneModifier

PsqlVaryingModifier = 'varying'

PsqlPrecisionModifier = 'precision'

PsqlTimeZoneModifier =
   with_or_without: ('with' | 'without')
   'time'
   'zone'

PsqlTypeArguments =
   '('
   items: PsqlTypeArgumentList
   ')'

PsqlTypeArgumentList = (PsqlNumberLiteralExpression (',' PsqlNumberLiteralExpression)*)

AnyPsqlTypeArraySuffix =
   PsqlTypeArraySuffix
   | PsqlTildeArraySuffix

PsqlTypeArraySuffix = '[' ']'

// `int~[]~` -- mlang-dialect escaping of the array-type-suffix brackets, not
// real Postgres syntax. Unlike `~name~`, this needs no re-lex: `~`, `[`, `]`
// and `~` already lex correctly as four separate default tokens here (no
// ambiguity with the regex/LIKE operators, since this position never
// follows a complete left-hand expression). The two `~`s need explicit
// labels -- otherwise codegen gives both the same accessor name and the
// generated struct doesn't compile (duplicate field).
PsqlTildeArraySuffix =
   open_tilde: '~'
   '['
   ']'
   close_tilde: '~'

PsqlSubqueryExpression =
   '('
   query: PsqlSelectStatement
   ')'

PsqlUnaryExpression =
   operator_token: ('not' | '-' | '+')
   expression: AnyPsqlExpression

PsqlIsNullExpression =
   expression: AnyPsqlExpression
   'is'
   'not'?
   'null'

PsqlBetweenExpression =
   expression: AnyPsqlExpression
   'not'?
   'between'
   low: AnyPsqlExpression
   'and'
   high: AnyPsqlExpression

PsqlInExpression =
   expression: AnyPsqlExpression
   'not'?
   'in'
   source: AnyPsqlInSource

AnyPsqlInSource =
   PsqlInValueList
   | PsqlSubqueryExpression

PsqlInValueList =
   '('
   items: PsqlExpressionList
   ')'

PsqlLikeExpression =
   expression: AnyPsqlExpression
   'not'?
   operator_token: ('like' | 'ilike')
   pattern: AnyPsqlExpression

PsqlCaseExpression =
   'case'
   expression: AnyPsqlExpression?
   when_clauses: PsqlCaseWhenClauseList
   else_clause: PsqlCaseElseClause?
   'end'

PsqlCaseWhenClauseList = PsqlCaseWhenClause*

PsqlCaseWhenClause =
   'when'
   condition: AnyPsqlExpression
   'then'
   result: AnyPsqlExpression

PsqlCaseElseClause =
   'else'
   result: AnyPsqlExpression

PsqlCallExpression =
   schema: PsqlShemaName?
   name: AnyPsqlName
   '('
   arguments: PsqlExpressionList
   ')'

PsqlWindowFunctionExpression =
   call: PsqlCallExpression
   'over'
   window: PsqlWindowSpecification

PsqlWindowSpecification =
   '('
   partition_by_clause: PsqlWindowPartitionByClause?
   order_by_clause: PsqlOrderByClause?
   ')'

PsqlWindowPartitionByClause =
   'partition_by'
   items: PsqlWindowPartitionByItemList

PsqlWindowPartitionByItemList = (AnyPsqlExpression (',' AnyPsqlExpression)*)

PsqlBinaryExpression =
   left: AnyPsqlExpression
   operator_token: (
   '<' | '>' | '<=' | '>=' | '=' | '!=' | '<>'
   | '+' | '-' | '*' | '/' | '%' | '~'  | '!~'
   | '&' | '|' | '^' | '>>' | '<<' | '~*' | '!~*'
   | '~~' | '~~*' | '!~~' | '!~~*'
   )
   right: AnyPsqlExpression

PsqlLogicalExpression =
	left: AnyPsqlExpression
	operator_token: ('and' | 'or')
	right: AnyPsqlExpression

PsqlParenthesizedExpression =
	'(' expression: AnyPsqlExpression ')'

